{
  "name": "riffscan",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:dsp": "esbuild scripts/test-dsp.ts --bundle --platform=node --format=esm --outfile=.tmp/test-dsp.mjs --log-level=warning && node .tmp/test-dsp.mjs",
    "fetch-model": "node scripts/fetch-model.mjs",
    "prebuild": "node scripts/fetch-model.mjs",
    "predev": "node scripts/fetch-model.mjs"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@huggingface/transformers": "^3.8.1",
    "@mediabunny/mp3-encoder": "^1.61.0",
    "@spotify/basic-pitch": "^1.0.1",
    "@tensorflow/tfjs": "^4.22.0",
    "@tonejs/midi": "^2.0.28",
    "idb-keyval": "^6.3.0",
    "mediabunny": "^1.61.0",
    "onnxruntime-web": "^1.23.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "5.9",
    "vite": "^6.4.3"
  },
  "overrides": {
    "@spotify/basic-pitch": {
      "@tensorflow/tfjs": "$@tensorflow/tfjs"
    }
  }
}
